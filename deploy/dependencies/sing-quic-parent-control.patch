+		case <-conn.Context().Done():
+			var app *quic.ApplicationError
+			if !errors.As(context.Cause(conn.Context()), &app) || !app.Remote {
+				t.Fatal("no remote CONNECTION_CLOSE")
+			}
+		case <-ctx.Done():
+			t.Fatal("parent close timed out")
+		}
+	}
+	owner.mu.Lock()
+	retained := len(owner.parents)
+	owner.mu.Unlock()
+	if retained != 0 {
