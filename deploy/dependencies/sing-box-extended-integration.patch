+			case err := <-flush:
+				s.closeErr = errors.Join(s.closeErr, err)
+			case <-ctx.Done():
+				s.closeErr = errors.Join(s.closeErr, errors.New("SSM_CACHE_DRAIN_TIMEOUT"))
+			}
+		}
+	})
