+	response.Body.Close()
+	if response.StatusCode != http.StatusNoContent {
+		t.Fatal("HTTP readiness rejected")
+	}
+	if err = scope.Close(); err != nil {
+		t.Fatal("scope cleanup", err)
+	}
+	reused, err := net.Listen("tcp", address)
+	if err != nil {
+		t.Fatal("scope retained listener", err)
