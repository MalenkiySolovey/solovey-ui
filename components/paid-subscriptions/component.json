{
  "id": "paid-subscriptions",
  "name": "Paid Subscriptions",
  "version": "1",
  "since": "2026.1.0",
  "delivery": "in-process",
  "defaultEnabled": true,
  "frontend": {
    "entries": [
      "frontend/index.ts"
    ]
  },
  "database": {
	"schema": "solovey.durable-resource/v1",
	"schemaVersion": "2",
	"migrationVersion": "2",
	"indexPolicy": "ALL_OWNED_TABLE_INDEXES",
    "tables": [
	  "paidsub_bindings",
	  "payment_orders",
	  "tariffs"
	],
	"settings": [
	  "paidSubAutoInbounds", "paidSubAutoRegister", "paidSubBotPollSeconds", "paidSubCryptoBotEnabled",
	  "paidSubCurrency", "paidSubEnabled", "paidSubExternalEnabled", "paidSubExternalUrlTemplate",
	  "paidSubGreeting", "paidSubMaxClients", "paidSubOrderTTLMinutes", "paidSubOutboundTag",
	  "paidSubPayMasterEnabled", "paidSubRefundRevoke", "paidSubStarsEnabled", "paidSubStartRateLimitPerMin",
	  "paidSubStripeEnabled", "paidSubTransportMode", "paidSubTrialDays", "paidSubTrialVolumeGB",
	  "paidSubUpdateOffset", "paidSubYooKassaEnabled"
	],
	"secrets": [
	  "paidSubBotToken", "paidSubCryptoBotToken", "paidSubPayMasterToken", "paidSubProxyPassword",
	  "paidSubProxyURL", "paidSubProxyUsername", "paidSubStripeToken", "paidSubYooKassaToken"
	],
	"backupCodec": "SQLITE_OWNER_V1",
	"restoreHook": "MIGRATE_AND_VALIDATE_V1",
	"dropDataPlan": "OWNER_LIFECYCLE_V1",
	"dropPostcondition": "DECLARED_RESOURCES_ABSENT_V1",
	"redactionClass": "SENSITIVE",
	"portabilityClass": "PORTABLE",
	"compatibilityRange": {"minimumSchema": "1", "maximumSchema": "2"}
  }
}
