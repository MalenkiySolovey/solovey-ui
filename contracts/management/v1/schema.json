          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "changeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        }
      },
      "required": [
        "host",
        "owner",
        "resourceId",
        "operationId",
        "correlationId",
        "changeId"
      ],
      "additionalProperties": false,
      "maxProperties": 48
    },
    "Problem": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "code": {
          "$ref": "#/$defs/ReasonCode"
