{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MalenkiySolovey/solovey-ui/contracts/management/v1/schema.json",
  "title": "Solovey management semantic contract v1",
  "x-contractVersion": "solovey.management/v1",
  "x-actions": [
    {
      "id": "backup.restore",
      "owner": "data",
      "permission": "backup.restore",
      "hostScope": "TARGET_HOST",
      "resourceScope": "database",
      "riskClass": "CRITICAL",
      "inputSchema": "solovey.action/backup.restore/v1",
      "preview": true,
      "stepUpPolicy": "existing_browser_one_use_or_verified_startup_recovery",
      "auditClass": "db_imported",
      "revisionFence": "OWNER_REQUIRED"
    },
    {
      "id": "component.remove",
      "owner": "component-lifecycle",
      "permission": "component.uninstall",
      "hostScope": "TARGET_HOST",
      "resourceScope": "component:<id>",
      "riskClass": "HIGH",
      "inputSchema": "solovey.action/component.remove/v1",
      "preview": false,
      "stepUpPolicy": "existing_browser_one_use",
      "auditClass": "component_installed_changed",
      "componentId": "panel-update-ui",
      "revisionFence": "OWNER_LIFECYCLE"
    }
  ],
  "x-reasons": [
    "ACCEPTED",
    "UNSUPPORTED",
    "ABSENT",
    "DISABLED",
    "INVALID_INPUT",
    "PERMISSION_DENIED",
    "APPROVAL_REQUIRED",
    "AUTHORITY_UNAVAILABLE",
    "REVISION_CONFLICT",
    "RESOURCE_CONFLICT",
    "STALE_STATE",
    "CAPABILITY_UNAVAILABLE",
    "DEPENDENCY_UNAVAILABLE",
    "CANCELLED",
    "IN_PROGRESS",
    "ALREADY_EXISTS",
    "RECOVERY_REQUIRED",
    "UNKNOWN",
    "INTERNAL"
  ],
  "x-inputs": {
    "backup.restore": "RestoreInput",
    "component.remove": "ComponentRemoveInput"
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:@+-]+$"
    },
    "Revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:@+-]+$"
    },
    "Digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "Generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "NodeID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^node:[A-Za-z0-9._-]+$"
    },
    "HostRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "LOCAL",
            "NODE"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "maxProperties": 48,
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "LOCAL"
            },
            "id": {
              "const": "local"
            }
          },
          "required": [],
          "additionalProperties": true,
          "maxProperties": 48
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "NODE"
            },
            "id": {
              "$ref": "#/$defs/NodeID"
            }
          },
          "required": [],
          "additionalProperties": true,
          "maxProperties": 48
        }
      ]
    },
    "ResourceRef": {
      "type": "object",
      "properties": {
        "host": {
          "$ref": "#/$defs/HostRef"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        }
      },
      "required": [
        "host",
        "owner",
        "resourceId"
      ],
      "additionalProperties": false,
      "maxProperties": 48
    },
    "NodeIdentity": {
      "type": "object",
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/NodeID"
        },
        "host": {
          "$ref": "#/$defs/HostRef"
        },
        "managementIdentityRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "enrollmentState": {
          "type": "string",
          "enum": [
            "UNENROLLED",
            "ENROLLED",
            "REVOKED"
          ]
        },
        "authorityRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "authorizationGeneration": {
          "$ref": "#/$defs/Generation"
        }
      },
      "required": [
        "nodeId",
        "host",
        "managementIdentityRef",
        "enrollmentState"
      ],
      "additionalProperties": false,
      "maxProperties": 48
    },
    "NetworkObservation": {
      "type": "object",
      "properties": {
        "host": {
          "$ref": "#/$defs/HostRef"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "observedAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "freshUntil": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mac": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        }
      },
      "required": [
        "host",
        "source",
        "observedAt",
        "freshUntil"
      ],
      "additionalProperties": true,
      "maxProperties": 48
    },
    "ActionDescriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "permission": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "hostScope": {
          "type": "string",
          "enum": [
            "TARGET_HOST"
          ]
        },
        "resourceScope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+<>-]+$"
        },
        "riskClass": {
          "type": "string",
          "enum": [
            "HIGH",
            "CRITICAL"
          ]
        },
        "inputSchema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]+$"
        },
        "preview": {
          "type": "boolean"
        },
        "stepUpPolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "auditClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "componentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9-]+$"
        },
        "revisionFence": {
          "type": "string",
          "enum": [
            "OWNER_REQUIRED",
            "OWNER_LIFECYCLE"
          ]
        }
      },
      "required": [
        "id",
        "owner",
        "permission",
        "hostScope",
        "resourceScope",
        "riskClass",
        "inputSchema",
        "preview",
        "stepUpPolicy",
        "auditClass",
        "revisionFence"
      ],
      "additionalProperties": false,
      "maxProperties": 48
    },
    "RestoreInput": {
      "type": "object",
      "properties": {
        "rehearsalRevision": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "rehearsalRevision"
      ],
      "additionalProperties": false,
      "maxProperties": 48
    },
    "ComponentRemoveInput": {
      "type": "object",
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9-]+$"
        }
      },
      "required": [
        "componentId"
      ],
      "additionalProperties": false,
      "maxProperties": 48
    },
    "Command": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "solovey.management/v1"
        },
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "actionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "host": {
          "$ref": "#/$defs/HostRef"
        },
        "resource": {
          "$ref": "#/$defs/ResourceRef"
        },
        "expectedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "inputSchema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]+$"
        },
        "inputDigest": {
          "$ref": "#/$defs/Digest"
        },
        "input": {
          "oneOf": [
            {
              "$ref": "#/$defs/RestoreInput"
            },
            {
              "$ref": "#/$defs/ComponentRemoveInput"
            }
          ]
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "grantRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        }
      },
      "required": [
        "contractVersion",
        "commandId",
        "actionId",
        "host",
        "resource",
        "generation",
        "inputSchema",
        "inputDigest",
        "input",
        "correlationId",
        "grantRef"
      ],
      "additionalProperties": false,
      "maxProperties": 48
    },
    "ManagementGrant": {
      "type": "object",
      "properties": {
        "grantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "actorRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "authorityRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "actionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "permission": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "host": {
          "$ref": "#/$defs/HostRef"
        },
        "resource": {
          "$ref": "#/$defs/ResourceRef"
        },
        "inputDigest": {
          "$ref": "#/$defs/Digest"
        },
        "authorizationGeneration": {
          "$ref": "#/$defs/Generation"
        },
        "credentialGeneration": {
          "$ref": "#/$defs/Generation"
        },
        "mfaGeneration": {
          "$ref": "#/$defs/Generation"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "oneUse": {
          "type": "boolean"
        }
      },
      "required": [
        "grantId",
        "actorRef",
        "authorityRef",
        "actionId",
        "permission",
        "host",
        "resource",
        "inputDigest",
        "authorizationGeneration",
        "credentialGeneration",
        "mfaGeneration",
        "expiresAt",
        "nonce",
        "oneUse"
      ],
      "additionalProperties": false,
      "maxProperties": 48
    },
    "ReasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "CommandResult": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "solovey.management/v1"
        },
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "host": {
          "$ref": "#/$defs/HostRef"
        },
        "resource": {
          "$ref": "#/$defs/ResourceRef"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "reason": {
          "$ref": "#/$defs/ReasonCode"
        },
        "observedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "replay": {
          "type": "boolean"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "changeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "ownerReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        },
        "message": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "contractVersion",
        "commandId",
        "host",
        "resource",
        "status",
        "reason",
        "observedRevision",
        "generation",
        "replay",
        "correlationId"
      ],
      "additionalProperties": true,
      "maxProperties": 48,
      "description": "host must equal resource.host. Unknown reason codes remain data but cannot be interpreted as accepted success."
