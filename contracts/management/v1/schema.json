            "no",
            "unknown"
          ]
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:@+-]+$"
        }
      },
      "required": [
        "host",
        "owner",
        "id",
        "value",
        "revision",
        "source"
      ],
      "additionalProperties": true,
      "maxProperties": 48
