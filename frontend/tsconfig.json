{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@solovey/component-ui": ["./src/componentSystem/sdk.ts"],
      "@solovey/component-ui/api": ["./src/componentSystem/api.ts"],
      "@solovey/component-ui/contributions": ["./src/componentSystem/contributions.ts"],
      "@solovey/component-ui/observation": ["./src/componentSystem/observation.ts"],
      "@/*": ["./src/*"],
      "vue": ["./node_modules/vue"],
      "vue-i18n": ["./node_modules/vue-i18n"],
      "vue-router": ["./node_modules/vue-router"],
      "notivue": ["./node_modules/notivue"],
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "../components/*/frontend/**/*.ts", "../components/*/frontend/**/*.vue", "../.component-sources/*/frontend/**/*.ts", "../.component-sources/*/frontend/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }],
  "exclude": ["node_modules"],
}
